#!/bin/sh
# otsh — one command for starting, building and running SSH-served TUIs.
#
#   otsh new ~/src/myapp      scaffold a project that builds and serves as-is
#   otsh run ~/src/myapp      build it and start it
#   otsh build ~/src/myapp    build it
#   otsh flags                print the two flags, for your own build system
#   otsh doctor               check the three things that actually go wrong
#
# The tool itself is an Odin program in cmd/otsh — it used to be ~900 lines of
# bash, which did not run at all on a stock Alpine, on FreeBSD, or on any
# Linux stripped to essentials, and macOS's /bin/bash is a 3.2 whose heredoc
# parsing already cost this project one real bug. This file is only the
# bootstrap: it builds cmd/otsh into bin/ on first use (and again when its
# sources change) and execs it. After that first build it is a two-stat
# detour on the way to the real tool.
#
# /bin/sh, not bash, and strictly POSIX: the whole point of the rewrite is
# machines where bash does not exist, so the bootstrap must not smuggle the
# dependency back in. Everything portable-sh cannot do lives in cmd/otsh.
#
# Building the tool needs the Odin compiler — which is fine, because so does
# everything else here: otsh's one job is driving that compiler at a source
# collection. The one honest gap is the machine that has no Odin yet, whose
# owner runs `otsh doctor` to find out what is missing. For exactly that case
# the tail of this file carries a portable-sh copy of doctor's checklist (and
# of help and version), so the answer is the same checklist it always was,
# not a shell error. Keep it in step with cmd/otsh/doctor.odin — change one,
# change the other.
#
# Install it by putting a symlink on your PATH — this file stays in the
# checkout, because the checkout is what your app compiles against:
#
#   ln -s "$PWD/otsh" ~/.local/bin/otsh
#
# so it resolves its own real location through that symlink rather than
# trusting $0 blindly. Nothing is installed anywhere else, and nothing here
# changes how otsh is distributed: -collection:otsh= still points at a source
# tree, so the version your app uses is still whatever commit this checkout
# is on. Prebuilt binaries from the GitHub releases are the same tool
# compiled for you: drop one into bin/ under its release name —
# bin/otsh-linux-amd64, say — and this file execs it without ever building.
set -eu

# --- where am I ---------------------------------------------------------------
# Walk the symlink chain by hand rather than with `readlink -f`, which is a
# GNU extension that macOS did not carry for most of its life and that Git
# Bash inherits from MSYS. Plain `readlink` is everywhere, busybox included.
self="$0"
while [ -L "$self" ]; do
	self_dir="$(CDPATH='' cd -P "$(dirname "$self")" && pwd)"
	link="$(readlink "$self")"
	case "$link" in
	/*) self="$link" ;;
	*) self="$self_dir/$link" ;;
	esac
done
OTSH="$(CDPATH='' cd -P "$(dirname "$self")" && pwd)"

# build.sh and test.sh set this so their diagnostics still say "build.sh:"
# rather than pointing at a wrapper the caller never invoked.
PROG="${OTSH_PROG:-otsh}"

# The tool is named per OS and architecture — bin/otsh-linux-arm64, not
# bin/otsh — because one checkout is often seen by two machines at once: a
# worktree bind-mounted into a container builds its Linux tool beside the
# host's macOS one instead of exec-ing it and dying on "exec format error".
# The names match the GitHub release artifacts on purpose, so a downloaded
# binary drops into bin/ as-is and this file execs it without ever building.
EXE=
case "$(uname -s)" in
Darwin) TOOL_OS=darwin ;;
Linux) TOOL_OS=linux ;;
FreeBSD) TOOL_OS=freebsd ;;
MINGW* | MSYS* | CYGWIN*)
	TOOL_OS=windows
	EXE=.exe
	;;
*) TOOL_OS="$(uname -s | tr 'A-Z' 'a-z')" ;;
esac
case "$(uname -m)" in
arm64 | aarch64) TOOL_ARCH=arm64 ;;
x86_64 | amd64) TOOL_ARCH=amd64 ;;
*) TOOL_ARCH="$(uname -m)" ;;
esac
TOOL="$OTSH/bin/otsh-$TOOL_OS-$TOOL_ARCH$EXE"

# --- the fast path ------------------------------------------------------------
# A built tool that is newer than every file in cmd/otsh runs as-is. `find
# -newer` is POSIX and busybox has it; a missing bin/ just means building.
if [ -x "$TOOL" ] && [ -z "$(find "$OTSH/cmd/otsh" -type f -newer "$TOOL" 2>/dev/null)" ]; then
	exec "$TOOL" "$@"
fi

# --- find the compiler --------------------------------------------------------
# The same resolution order cmd/otsh itself uses, so the tool the bootstrap
# builds is built by the compiler the tool would have chosen:
#   $ODIN, then .odin-path in this checkout, then the use-odin config file,
#   then $PATH, then the places Odin actually ends up when built from source.
# Each file is only taken when what it names actually resolves.
home="${HOME:-/nonexistent}"
ODIN_CONF="${XDG_CONFIG_HOME:-$home/.config}/otsh/odin-path"

odin="${ODIN:-}"
if [ -z "$odin" ]; then
	for f in "$OTSH/.odin-path" "$ODIN_CONF"; do
		[ -f "$f" ] || continue
		p="$(cat "$f")"
		if command -v "$p" >/dev/null 2>&1; then
			odin="$p"
			break
		fi
	done
fi
if [ -z "$odin" ] && command -v odin >/dev/null 2>&1; then
	odin=odin
fi
if [ -z "$odin" ]; then
	for p in "${ODIN_ROOT:-}/odin" \
		"$home/odin/odin" "$home/.odin/odin" \
		"$home/src/Odin/odin" "$home/src/odin/odin" \
		"$home/Odin/odin" "$home/dev/Odin/odin" \
		/usr/local/odin/odin /opt/odin/odin /opt/Odin/odin; do
		case "$p" in /odin) continue ;; esac
		if [ -x "$p" ] && "$p" version >/dev/null 2>&1; then
			odin="$p"
			break
		fi
	done
fi

# What require_odin would report having tried: an explicit $ODIN even when it
# resolves to nothing, `odin` otherwise.
tried="${odin:-${ODIN:-odin}}"

if [ -n "$odin" ] && command -v "$odin" >/dev/null 2>&1; then
	# First run, or cmd/otsh changed under the built tool. Compiler errors go
	# straight to the caller — swallowing them would turn a broken tree into
	# "otsh stopped working" with no evidence.
	echo "$PROG: building the otsh tool (cmd/otsh -> bin/otsh-$TOOL_OS-$TOOL_ARCH$EXE)..." >&2
	mkdir -p "$OTSH/bin"
	"$odin" build "$OTSH/cmd/otsh" -out:"$TOOL"
	exec "$TOOL" "$@"
fi

# --- no compiler anywhere -----------------------------------------------------
# The tool cannot be built, so the read-only commands are answered here, in
# portable sh, and everything else gets the same message `otsh build` gives.
# This tail exists for one reader: the person on a fresh machine asking
# doctor what is missing. Its output must match cmd/otsh — the golden battery
# in the commit that introduced it diffed the two.

sh_otsh_version() {
	[ -f "$OTSH/ssh/version.odin" ] || {
		printf '(unknown)'
		return
	}
	awk -F'"' '/^VERSION ::/ {print $2; exit}' "$OTSH/ssh/version.odin"
}

# Sets LIBDIR, exactly as cmd/otsh's resolve_libssh does.
sh_resolve_libssh() {
	case "$(uname -s)" in
	MINGW* | MSYS* | CYGWIN*)
		LIBDIR="${VCPKG_ROOT:-${VCPKG_INSTALLATION_ROOT:-C:/vcpkg}}/installed/x64-windows/lib"
		;;
	*)
		if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libssh; then
			LIBDIR="$(pkg-config --variable=libdir libssh)"
		elif [ -d /opt/homebrew/opt/libssh/lib ]; then
			LIBDIR="/opt/homebrew/opt/libssh/lib"
		else
			LIBDIR="/usr/local/lib"
		fi
		;;
	esac
}

sh_libssh_version() {
	if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libssh; then
		pkg-config --modversion libssh
		return 0
	fi
	for inc in \
		"${LIBDIR%/lib}/include" \
		/opt/homebrew/opt/libssh/include \
		/usr/local/opt/libssh/include \
		/opt/homebrew/include \
		/usr/local/include \
		/usr/include \
		/opt/local/include; do
		h="$inc/libssh/libssh_version.h"
		if [ -f "$h" ]; then
			awk '/^#define LIBSSH_VERSION_MAJOR/ {maj=$3}
			     /^#define LIBSSH_VERSION_MINOR/ {min=$3}
			     /^#define LIBSSH_VERSION_MICRO/ {mic=$3}
			     END {if (maj != "") printf "%s.%s.%s\n", maj, min, mic}' "$h"
			return 0
		fi
	done
	return 1
}

sh_libssh_lib_present() {
	for f in "$LIBDIR"/libssh.so* "$LIBDIR"/libssh.dylib "$LIBDIR"/libssh.a "$LIBDIR"/ssh.lib; do
		if [ -e "$f" ]; then return 0; fi
	done
	return 1
}

# $1 >= $2, both dotted numeric. Positional parameters are function-local in
# POSIX sh, so `set --` here clobbers nothing outside.
sh_version_ge() {
	va="$(printf '%s' "$1" | sed 's/[^0-9.].*//')"
	vb="$(printf '%s' "$2" | sed 's/[^0-9.].*//')"
	oldIFS="${IFS-}"
	IFS=.
	set -- $va
	a1="${1:-0}" a2="${2:-0}" a3="${3:-0}"
	set -- $vb
	b1="${1:-0}" b2="${2:-0}" b3="${3:-0}"
	IFS="$oldIFS"
	[ $((a1 * 10000 + a2 * 100 + a3)) -ge $((b1 * 10000 + b2 * 100 + b3)) ]
}

sh_doctor() {
	printf 'otsh doctor — %s\n\n' "$OTSH"
	fails=1 # odin, or this code would not be running
	warns=0

	printf '  FAIL  %-9s %s\n' odin "not found (tried '$tried')"
	printf '        %-9s %s\n' "" "install from https://odin-lang.org, or if it lives somewhere"
	printf '        %-9s %s\n' "" "custom: $PROG use-odin /path/to/odin"

	sh_resolve_libssh
	ver="$(sh_libssh_version || true)"
	if [ -n "$ver" ] && ! sh_version_ge "$ver" 0.10.6; then
		printf '  FAIL  %-9s %s\n' libssh "$ver is below the 0.10.6 floor — ssh.serve will refuse to start"
		printf '        %-9s %s\n' "" "0.10.6 carries the fix for CVE-2023-48795 (Terrapin)."
		fails=$((fails + 1))
	elif ! sh_libssh_lib_present; then
		if [ -n "$ver" ]; then
			printf '  warn  %-9s %s\n' libssh "headers say $ver, but there is no libssh in $LIBDIR"
			printf '        %-9s %s\n' "" "that is the path otsh passes to the linker — install pkg-config so it is found properly"
			warns=$((warns + 1))
		else
			printf '  FAIL  %-9s %s\n' libssh "not found (looked in $LIBDIR)"
			printf '        %-9s %s\n' "" "brew install libssh pkg-config     # macOS"
			printf '        %-9s %s\n' "" "apt install libssh-dev pkg-config  # Debian/Ubuntu"
			printf '        %-9s %s\n' "" "vcpkg install libssh:x64-windows   # Windows"
			fails=$((fails + 1))
		fi
	elif [ -n "$ver" ]; then
		printf '  ok    %-9s %s\n' libssh "$ver  (>= 0.10.6)  $LIBDIR"
	else
		printf '  warn  %-9s %s\n' libssh "$LIBDIR has the library but no version to check"
		printf '        %-9s %s\n' "" "install pkg-config or the libssh headers; the 0.10.6 floor is enforced at run time regardless"
		warns=$((warns + 1))
	fi

	if command -v clang >/dev/null 2>&1; then
		printf '  ok    %-9s %s\n' clang "$(command -v clang)"
	elif [ "$(uname -s)" = Linux ]; then
		printf '  FAIL  %-9s %s\n' clang "not found — Odin links with it on Linux"
		printf '        %-9s %s\n' "" "apt install clang  (build-essential is not a substitute)"
		fails=$((fails + 1))
	else
		printf '  --    %-9s %s\n' clang "not found — not required on $(uname -s)"
	fi

	missing=""
	for pkg in libssh ssh tui sshtui; do
		[ -d "$OTSH/$pkg" ] || missing="$missing $pkg"
	done
	if [ -z "$missing" ]; then
		printf '  ok    %-9s %s\n' otsh "$(sh_otsh_version)  (libssh, ssh, tui, sshtui)"
	else
		printf '  FAIL  %-9s %s\n' otsh "$OTSH is missing package(s):$missing"
		printf '        %-9s %s\n' "" "this file must stay inside the checkout; symlink it, do not copy it"
		fails=$((fails + 1))
	fi

	printf '\n%d problem(s) — nothing will build until these are fixed\n' "$fails"
	exit 1
}

sh_version() {
	printf 'otsh %s\n' "$(sh_otsh_version)"
	printf '  source   %s\n' "$OTSH"
	if command -v git >/dev/null 2>&1 && commit="$(git -C "$OTSH" describe --tags --always --dirty 2>/dev/null)"; then
		printf '  commit   %s\n' "$commit"
	fi
}

sh_help() {
	cat <<EOF
otsh $(sh_otsh_version) — SSH-served TUIs in Odin
$OTSH

usage: otsh <command> [arguments]

  new <dir> [--port N]   scaffold a project that builds and serves as-is
                         (picks a free port unless you name one)
  build [dir] [flags]    build a project; extra flags go to \`odin build\`
                         --static        link libssh from its archive, so the
                                         binary needs no libssh installed
                         --fully-static  no dynamic dependencies at all
                                         (Linux only — see docs)
  run [dir] [args]       build, then run it from its own directory
  test [dir] [flags]     run a package's tests (default: otsh's own suite)
  flags [--static]       print the -collection: and -extra-linker-flags:
                         values, for a Makefile, justfile or IDE
  install                put \`otsh\` on your \$PATH (or --uninstall)
  use-odin [path]        record where your Odin compiler lives (or --unset)
  doctor                 check odin, libssh and clang
  version                version and checkout of this otsh
  help                   this

The first bare word is the package directory; everything starting with a dash
is passed through to the compiler.

  otsh new ~/src/myapp
  otsh run ~/src/myapp          # then: ssh -p 2222 localhost
  otsh build ~/src/myapp -o:speed

To have it on your PATH from anywhere, symlink it — the file stays here,
because this checkout is what your app compiles against:

  ln -s $OTSH/otsh ~/.local/bin/otsh

docs: $OTSH/docs/getting-started.md
EOF
}

cmd="${1:-help}"
case "$cmd" in
doctor) sh_doctor ;;
version | --version | -v) sh_version ;;
help | --help | -h) sh_help ;;
*)
	printf '%s: odin compiler not found (tried '\''%s'\'').\n' "$PROG" "$tried" >&2
	printf '  %s\n' "Install it from https://odin-lang.org, or if you have it somewhere" >&2
	printf '  %s\n' "custom, record that once for every project:" >&2
	printf '  %s\n' "    $PROG use-odin /path/to/odin" >&2
	printf '  %s\n' "For a single command, ODIN=/path/to/odin $PROG ... also works." >&2
	exit 1
	;;
esac
