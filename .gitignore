# --- secrets -----------------------------------------------------------------
# Host keys identify the server; identity secrets are the HMAC key behind every
# user's pseudonymous id. Committing either is a real leak, so match broadly.
*hostkey
*hostkey.pub
*_secret
hostkey
id_ed25519*
id_rsa*
*.pem

# --- build output ------------------------------------------------------------
# build.sh drops the binary in the repo root, named after the source directory.
# On Windows the same name carries a .exe (and link.exe leaves a .pdb beside it).
/tracker
/whoami
/members
/guestbook
/stopwatch
/notes
# The two apps the docs have you build yourself: docs/getting-started.md walks
# through `./build.sh ~/src/greeter`, docs/ssh.md through the sshdoc example.
# Both land in the repo root too, the same way the bundled examples do.
/greeter
/sshdoc
# `./otsh build <dir>` leaves the binary beside its source instead of in the
# current directory, so an example built that way lands one level down. Same
# binaries, different place; the .exe/.pdb/.dSYM rules below are unanchored and
# already cover the Windows and macOS debug leftovers wherever they appear.
/examples/tracker/tracker
/examples/whoami/whoami
/examples/members/members
/examples/guestbook/guestbook
/examples/stopwatch/stopwatch
/examples/notes/notes
# The compiled otsh tool: ./otsh (the sh bootstrap) builds cmd/otsh in here
# on first use. A prebuilt release binary dropped at bin/otsh is used as-is.
/bin/
*.exe
*.pdb
*.o
*.bin
*.dSYM/

# --- generated ---------------------------------------------------------------
# Rebuild with: python3 docs/tools/build_site.py
docs/site/
# Byte-compiled caches CPython leaves behind for the tools in docs/tools/.
__pycache__/
*.pyc

# --- runtime output ----------------------------------------------------------
# examples/whoami's header suggests `./whoami 2>audit.log` to keep the audit
# trail separate from the app's own chatter on stdout.
audit.log

# --- local machine config ----------------------------------------------------
# Optional path to the odin compiler, read by build.sh/test.sh when odin is not
# on PATH. Machine-specific by nature.
.odin-path

# --- editors / OS ------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# --- agent scratch ------------------------------------------------------------
# Worktrees the orchestration tooling creates inside the repo.
.claude/
